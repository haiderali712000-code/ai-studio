# ---- App ----
APP_NAME=Cliporra
NODE_ENV=production
PORT=3000
# Your public URL, no trailing slash (used for Google login redirect)
BASE_URL=https://yourdomain.com
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated. These emails become admins when they sign up or log in.
ADMIN_EMAILS=you@example.com
# Free credits for every new account
SIGNUP_CREDITS=10

# ---- MySQL (create the database in Hostinger hPanel > Databases) ----
DB_HOST=localhost
DB_PORT=3306
# Use the values from hPanel > Databases > MySQL (NOT root). Example: u123456789_studio
DB_USER=u123456789_studio
DB_PASSWORD=your-db-password
DB_NAME=u123456789_studio

# ---- Email (sends the sign-up verification code) ----
# Hostinger: hPanel > Emails > create a mailbox, then use smtp.hostinger.com, port 465, that mailbox and its password.
# Without these, local dev prints the code in the terminal; production sign-up with email will not work.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-mailbox-password
MAIL_FROM=Cliporra <no-reply@yourdomain.com>

# ---- Google login (console.cloud.google.com > APIs & Services > Credentials) ----
# Authorized redirect URI: BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI provider: anthropic or openai ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Video downloader ----
# Set DOWNLOADER_ENABLED=false to switch the tool off. DOWNLOAD_COST is credits per download (0 = free).
DOWNLOADER_ENABLED=true
DOWNLOAD_COST=1
DOWNLOAD_API_URL=https://freeapi.pro/api/alldl

# ---- Voiceover (text to speech, freeapi.pro SpeechSter) ----
# Set TTS_ENABLED=false to switch the tool off. TTS_COST is credits per voiceover (0 = free).
TTS_ENABLED=true
TTS_COST=1
TTS_API_URL=https://freeapi.pro
TTS_MAX_CHARS=5000

# ---- AI video maker (json2video.com) ----
# Get the key at json2video.com > Dashboard. The key stays on the server and is never sent to the browser.
# Without J2V_API_KEY the tool stays switched off. VIDEO_COST is credits per video.
J2V_API_KEY=
J2V_TEMPLATE_ID=H9bhMdrmHQ9ccvbBfbI7
VIDEO_ENABLED=true
VIDEO_COST=5

# ---- Text to handwriting (freeapi.pro HandSter) ----
# HAND_COST is credits per generation (0 = free). HAND_BRAND=false hides the provider's footer line on the pages.
HAND_ENABLED=true
HAND_COST=1
HAND_API_URL=https://freeapi.pro
HAND_MAX_CHARS=6000
HAND_BRAND=true
