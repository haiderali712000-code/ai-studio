<%- include('partials/shell-start') %>
<header class="page-head"><h1>Voiceover</h1><span class="muted"><%= cost ? 'Costs ' + cost + ' credit per voiceover' : 'Free to use' %></span></header>

<form id="tts-form" class="panel form wide" novalidate>
  <label>Your text
    <textarea name="text" id="tts-text" rows="8" maxlength="<%= maxChars %>" placeholder="Type or paste what the voice should say..." required autofocus></textarea>
    <small><span id="tts-count">0</span> / <%= maxChars %> characters</small>
  </label>

  <label>Language
    <select id="tts-lang"><option>Loading voices...</option></select>
  </label>
  <label>Voice
    <select id="tts-voice" name="voiceIndex" disabled></select>
  </label>

  <label>Pitch: <output id="tts-pitch-out">0</output>
    <input type="range" id="tts-pitch" min="-100" max="100" step="5" value="0">
  </label>
  <label>Speed: <output id="tts-rate-out">0</output>
    <input type="range" id="tts-rate" min="-100" max="100" step="5" value="0">
  </label>

  <p id="tts-error" class="alert" role="alert" hidden></p>
  <div><button class="btn btn-primary btn-lg" type="submit" id="tts-btn" disabled>Generate voiceover</button></div>
</form>

<section class="panel wide" id="tts-result" hidden>
  <h2>Your voiceover</h2>
  <audio id="tts-audio" controls style="width:100%;margin-bottom:1rem"></audio>
  <div class="dl-actions"><a class="btn btn-primary" id="tts-download" download="voiceover.mp3">Download MP3</a></div>
</section>
<script src="/public/js/voice.js"></script>
<%- include('partials/shell-end') %>
<%- include('partials/foot') %>
