<%- include('../partials/shell-start') %>
<header class="page-head"><h1>Admin</h1></header>
<%- include('_nav') %>
<% if (notice) { %><p class="notice"><%= notice %></p><% } %>
<section class="panel">
  <form class="search" method="get" action="/admin/users">
    <input type="search" name="q" value="<%= q %>" placeholder="Search name or email" aria-label="Search users">
    <button class="btn btn-ghost" type="submit">Search</button>
    <span class="muted"><%= total %> users</span>
  </form>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Credits</th><th>Joined</th><th>Actions</th></tr></thead>
    <tbody>
    <% users.forEach(function (u) { %>
      <tr>
        <td><strong><%= u.name %></strong><br><small class="muted"><%= u.email %><%= u.google ? ' (Google)' : '' %></small></td>
        <td><%= u.role %></td>
        <td><span class="status <%= u.status === 'active' ? 'done' : 'failed' %>"><%= u.status %></span></td>
        <td><%= u.credits %></td>
        <td><%= new Date(u.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
        <td class="actions">
          <form method="post" action="/admin/users/<%= u.id %>/credits" class="inline">
            <input type="number" name="amount" placeholder="+50" aria-label="Credits to add or remove" required>
            <button class="btn btn-ghost btn-sm" type="submit">Add credits</button>
          </form>
          <% if (u.id !== user.id) { %>
            <form method="post" action="/admin/users/<%= u.id %>/status" class="inline">
              <input type="hidden" name="status" value="<%= u.status === 'active' ? 'banned' : 'active' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= u.status === 'active' ? 'Suspend' : 'Reactivate' %></button>
            </form>
            <form method="post" action="/admin/users/<%= u.id %>/role" class="inline">
              <input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= u.role === 'admin' ? 'Remove admin' : 'Make admin' %></button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <% if (pages > 1) { %>
    <nav class="pager" aria-label="Pages">
      <% if (page > 1) { %><a href="/admin/users?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>">Previous</a><% } %>
      <span>Page <%= page %> of <%= pages %></span>
      <% if (page < pages) { %><a href="/admin/users?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>">Next</a><% } %>
    </nav>
  <% } %>
</section>
<%- include('../partials/shell-end') %>
<%- include('../partials/foot') %>
