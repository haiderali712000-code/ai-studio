<%- include('partials/shell-start') %>
<header class="page-head"><h1>AI video maker</h1><span class="muted"><%= cost ? 'Costs ' + cost + (cost > 1 ? ' credits' : ' credit') + ' per video' : 'Free to use' %></span></header>

<form id="topic-form" class="panel form wide" novalidate>
  <label>What is the video about?
    <textarea name="topic" id="topic" rows="3" maxlength="600" placeholder="e.g. The history of the Olympic Games, in 5 quick facts" required autofocus></textarea>
  </label>
  <fieldset>
    <legend>Number of scenes</legend>
    <div class="choices">
      <label class="choice"><input type="radio" name="count" value="4"><span>4</span></label>
      <label class="choice"><input type="radio" name="count" value="5" checked><span>5</span></label>
      <label class="choice"><input type="radio" name="count" value="6"><span>6</span></label>
      <label class="choice"><input type="radio" name="count" value="8"><span>8</span></label>
    </div>
  </fieldset>
  <p id="topic-error" class="alert" role="alert" hidden></p>
  <div class="btn-row">
    <button class="btn btn-primary btn-lg" type="submit" id="topic-btn">Write the script</button>
    <button class="btn btn-ghost" type="button" id="manual-btn">I will write it myself</button>
  </div>
  <p class="muted small-note">Writing the script is free. You can edit every scene before the video is made.</p>
</form>

<form id="video-form" class="wide" novalidate hidden data-max="<%= limits.maxScenes %>" data-voiceover="<%= limits.voiceover %>" data-prompt="<%= limits.prompt %>">
  <section class="panel form">
    <label>Video title
      <input type="text" id="v-title" maxlength="<%= limits.title %>" placeholder="Untitled video">
    </label>
  </section>

  <div id="scenes"></div>
  <p><button class="btn btn-ghost" type="button" id="add-scene">+ Add scene</button></p>

  <section class="panel form">
    <label>Voice
      <select id="v-voice">
        <% voices.forEach(function (v) { %><option value="<%= v.id %>"><%= v.label %></option><% }) %>
      </select>
    </label>
    <label class="check"><input type="checkbox" id="v-subs" checked> <span>Add captions</span></label>
    <label>Caption highlight colour
      <select id="v-color">
        <option value="gold">Gold</option><option value="mint">Mint</option><option value="white">White</option><option value="pink">Pink</option>
      </select>
    </label>
    <p id="video-error" class="alert" role="alert" hidden></p>
    <div><button class="btn btn-primary btn-lg" type="submit" id="video-btn">Create video</button></div>
    <p class="muted small-note">Rendering usually takes a few minutes. You can leave the page; the video will be in your History.</p>
  </section>
</form>
<script src="/public/js/video.js"></script>
<%- include('partials/shell-end') %>
<%- include('partials/foot') %>
